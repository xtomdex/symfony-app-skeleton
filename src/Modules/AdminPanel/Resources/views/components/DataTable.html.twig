<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                {% for column in columns %}
                    <th>
                        {% if column.sortable %}
                            {% set dir = this.sortDirection(column) %}
                            <a href="{{ this.sortUrl(column) }}" class="d-inline-flex align-items-center text-nowrap text-body">
                                {{ column.label }}
                                {% if dir == 'asc' %}
                                    <i class="ti tabler-chevron-up ms-1"></i>
                                {% elseif dir == 'desc' %}
                                    <i class="ti tabler-chevron-down ms-1"></i>
                                {% else %}
                                    <i class="ti tabler-sort-a-z ms-1"></i>
                                {% endif %}
                            </a>
                        {% else %}
                            {{ column.label }}
                        {% endif %}
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% if items|length == 0 %}
                <tr>
                    <td colspan="{{ columns|length }}" class="text-center text-muted py-5">
                        {{ emptyMessage }}
                    </td>
                </tr>
            {% else %}
                {% for item in items %}
                    <tr>
                        {% for column in columns %}
                            <td>
                                {% if column.template %}
                                    {{ include(column.template, { item: item }) }}
                                {% elseif column.property %}
                                    {{ attribute(item, column.property) }}
                                {% endif %}
                            </td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>
</div>
